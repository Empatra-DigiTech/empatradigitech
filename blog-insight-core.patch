diff --git a/public/assets/css/home/blog/blog.css b/public/assets/css/home/blog/blog.css
new file mode 100644
index 0000000..52511c6
--- /dev/null
+++ b/public/assets/css/home/blog/blog.css
@@ -0,0 +1,500 @@
+/* ========================================
+   BLOG / INSIGHT — SEO CONTENT SECTION
+   ======================================== */
+
+:root {
+    --blog-primary: rgb(15, 60, 93);
+    --blog-secondary: rgb(176, 46, 54);
+    --blog-gray-900: #1a1a1a;
+    --blog-gray-700: #4a4a4a;
+    --blog-gray-600: #5a5a5a;
+    --blog-gray-500: #6b7280;
+    --blog-gray-300: #d1d5db;
+    --blog-gray-200: #e5e7eb;
+    --blog-gray-100: #f3f4f6;
+    --blog-white: #ffffff;
+    --blog-radius-md: 0.6rem;
+    --blog-radius-lg: 0.85rem;
+    --blog-shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
+    --blog-shadow-md: 0 4px 14px -4px rgba(0, 0, 0, 0.12);
+    --blog-shadow-lg: 0 15px 35px -8px rgba(0, 0, 0, 0.18);
+}
+
+/* ========================================
+   PAGE HEADER
+   ======================================== */
+
+.blog-page-header {
+    padding: 150px 0 70px;
+    background: linear-gradient(135deg, var(--blog-primary) 0%, var(--blog-secondary) 100%);
+}
+
+.blog-page-header-content {
+    text-align: center;
+    color: var(--blog-white);
+}
+
+.blog-page-title {
+    font-size: 2.75rem;
+    font-weight: 700;
+    margin-bottom: 0.5rem;
+}
+
+.blog-page-subtitle {
+    font-size: 1.0625rem;
+    opacity: 0.92;
+    margin: 0;
+}
+
+/* ========================================
+   FILTER PILLS
+   ======================================== */
+
+.blog-section {
+    padding: 3.5rem 0;
+    background: var(--blog-gray-100);
+}
+
+.blog-filter {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.75rem;
+    justify-content: center;
+    margin-bottom: 2.5rem;
+}
+
+.filter-pill {
+    display: inline-block;
+    padding: 0.5rem 1.25rem;
+    border-radius: 999px;
+    background: var(--blog-white);
+    color: var(--blog-gray-700);
+    font-weight: 600;
+    font-size: 0.9375rem;
+    text-decoration: none;
+    border: 1px solid var(--blog-gray-200);
+    transition: all 0.25s ease;
+}
+
+.filter-pill:hover {
+    color: var(--blog-primary);
+    border-color: var(--blog-primary);
+    text-decoration: none;
+}
+
+.filter-pill.active {
+    background: linear-gradient(135deg, var(--blog-primary) 0%, var(--blog-secondary) 100%);
+    color: var(--blog-white);
+    border-color: transparent;
+    box-shadow: var(--blog-shadow-sm);
+}
+
+/* ========================================
+   BLOG CARD
+   ======================================== */
+
+.blog-card {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    background: var(--blog-white);
+    border-radius: var(--blog-radius-lg);
+    overflow: hidden;
+    box-shadow: var(--blog-shadow-md);
+    border: 1px solid var(--blog-gray-200);
+    transition: all 0.3s ease;
+}
+
+.blog-card:hover {
+    transform: translateY(-8px);
+    box-shadow: var(--blog-shadow-lg);
+    border-color: var(--blog-primary);
+}
+
+.blog-card-image {
+    position: relative;
+    display: block;
+    width: 100%;
+    aspect-ratio: 16 / 10;
+    overflow: hidden;
+    background: var(--blog-gray-100);
+}
+
+.blog-card-image img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    transition: transform 0.5s ease;
+}
+
+.blog-card:hover .blog-card-image img {
+    transform: scale(1.06);
+}
+
+.blog-badge {
+    position: absolute;
+    top: 0.85rem;
+    left: 0.85rem;
+    background: linear-gradient(135deg, var(--blog-primary) 0%, var(--blog-secondary) 100%);
+    color: var(--blog-white);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: 0.03em;
+    padding: 0.35rem 0.8rem;
+    border-radius: 999px;
+    box-shadow: var(--blog-shadow-sm);
+}
+
+.blog-card-body {
+    padding: 1.25rem 1.4rem 1.5rem;
+    display: flex;
+    flex-direction: column;
+    flex-grow: 1;
+}
+
+.blog-card-date {
+    display: flex;
+    align-items: center;
+    gap: 0.35rem;
+    font-size: 0.8125rem;
+    color: var(--blog-gray-500);
+    margin-bottom: 0.5rem;
+}
+
+.blog-title-link {
+    text-decoration: none;
+    color: inherit;
+}
+
+.blog-title {
+    font-size: 1.125rem;
+    font-weight: 700;
+    color: var(--blog-gray-900);
+    line-height: 1.4;
+    margin: 0 0 0.6rem;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+    transition: color 0.25s ease;
+}
+
+.blog-title-link:hover .blog-title {
+    color: var(--blog-primary);
+}
+
+.blog-excerpt {
+    font-size: 0.9rem;
+    color: var(--blog-gray-600);
+    line-height: 1.6;
+    margin-bottom: 1.1rem;
+    flex-grow: 1;
